# Copy to .env and supply values locally. Never commit real credentials.
DATABASE_URL=sqlite:///./docket.sqlite3
# For hosted Postgres: postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require
DOCKET_WRITE_TOKEN=
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
# The static GitHub Pages site works without an API. Optional local API address:
NEXT_PUBLIC_API_URL=http://localhost:8080
